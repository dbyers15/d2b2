---
// Featured (top row) — most general, clearest business outcome first
const featured = [
  {
    id: '01',
    category: 'CRM Automation',
    headline: 'Automated lead filtering that tags and routes without anyone in the loop',
    context: 'B2B services company',
    problem: 'Lead routing and follow-up automation inside the CRM depended on tags that were being managed by hand. As underlying data changed, the tags drifted. Agents were working off stale segments and the automation rules that were supposed to save them time were firing on bad information.',
    solution: 'Built a pipeline that pulls filtered lead data from the warehouse on a daily schedule, evaluates each record against the business logic, checks whether the relevant tag already exists on that contact in the CRM, sets it if the condition is met, and removes it when it\'s no longer true. The CRM\'s own rules engine then fires assignment, routing, and follow-up sequences off those tags automatically.',
    outcome: 'Agent buy rates increased 10% across the board. Better routing and timely follow-up, driven by accurate segmentation, added $15K in monthly revenue.',
  },
  {
    id: '02',
    category: 'Tracking / GTM',
    headline: '14 conversion events recovered across a two-domain funnel',
    context: 'Automotive marketplace',
    problem: 'Ad platforms had zero visibility into actual conversions. The offer funnel ran on a different domain than the main site, making it completely invisible to Google Ads and GA4. On top of that, the component framework in use was silently dropping click events — so even on-domain conversion signals were not firing. Budget allocation and bid optimization were running completely blind.',
    solution: 'Rebuilt the GTM container with cross-domain linker configuration. Rewrote click triggers to use CSS selector matching instead of element IDs, which the framework regenerates on each render. Extended unified tag coverage across Google Ads, Microsoft UET, and GA4 on both domains.',
    outcome: '14 conversion event types confirmed firing across both domains. Full attribution from first ad click to offer accepted, enabling accurate ROAS measurement and proper bid optimization for the first time.',
  },
];

// Standard (bottom row) — ordered general to specific
const standard = [
  {
    id: '03',
    category: 'Revenue Analytics',
    headline: 'True ROAS came in at 0.56. The platform said it was fine.',
    context: 'Growth-stage marketplace',
    problem: 'Paid search performance looked acceptable inside Google Ads. There was no system connecting ad spend to the internal sales database. Platform-modeled conversions and actual closed revenue were two different numbers, and nobody had a way to reconcile them.',
    solution: 'Python pipeline connecting the Google Ads API to an internal MySQL database. Monthly reconciliation layer that mapped campaign spend to actual transactions, verified against internal revenue reporting rather than platform conversion values.',
    outcome: 'True ROAS on the key campaign measured at 0.56. Lead-to-buy rate of 5%+ confirmed strong targeting — the problem was cost per acquisition, not campaign quality. Informed a campaign restructure and bid strategy change.',
  },
  {
    id: '04',
    category: 'AEO / Custom Integration',
    headline: 'Monitoring system for brand presence across five AI search engines',
    context: 'B2B SaaS',
    problem: 'AI search is answering questions that used to send traffic to websites. No tool existed to track how the brand appeared in answers from ChatGPT, Perplexity, Gemini, AI Overviews, and Copilot. Traditional rank tracking was completely blind to it.',
    solution: 'Direct integration with an early-access answer engine API. A five-surface dashboard comparing citation rates, response quality, and content gaps across engines, with weekly automated reporting built into the existing reporting stack.',
    outcome: 'Identified which content formats were being cited by AI engines and which were being ignored. Content strategy adjusted based on actual AI response behavior, not assumptions.',
  },
  {
    id: '05',
    category: 'Data Pipeline / Product',
    headline: 'A pitch tool that pulled live market data for every dealer meeting',
    context: 'Automotive marketplace',
    problem: 'A field sales team was pitching dealers with static slides. No way to show a specific dealer what their local market actually looked like — and no reliable internet connection in dealer meetings to pull it dynamically.',
    solution: 'Python pipeline against a production MySQL database, geographic modeling using haversine radius and DMA crosswalk to scope market data to each dealer\'s footprint, and a service-worker microsite that cached the data for full offline use on an iPad.',
    outcome: 'Sales team could demonstrate live, location-specific market data in a dealer meeting with no internet required. Data updated daily from the production database.',
  },
];
---

<section id="work">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Work</span>
      <h2>How the work actually looks</h2>
    </div>

    <!-- Featured row: 2 wide cards -->
    <div class="grid grid-featured">
      {featured.map(s => (
        <div class="card">
          <div class="card-meta">
            <span class="card-num">Case {s.id}</span>
            <span class="category">{s.category}</span>
          </div>
          <h3>{s.headline}</h3>
          <div class="context-label">{s.context}</div>
          <div class="sections">
            <div class="block">
              <div class="block-label">The problem</div>
              <p>{s.problem}</p>
            </div>
            <div class="block">
              <div class="block-label">The work</div>
              <p>{s.solution}</p>
            </div>
            <div class="outcome">
              <div class="outcome-icon" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="0" y="0" width="9" height="9" fill="#CFAE70"/>
                  <rect x="11" y="0" width="9" height="9" fill="none" stroke="#CFAE70" stroke-width="1"/>
                  <rect x="0" y="11" width="9" height="9" fill="none" stroke="#CFAE70" stroke-width="1"/>
                  <rect x="11" y="11" width="9" height="9" fill="#CFAE70"/>
                </svg>
              </div>
              <p>{s.outcome}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Standard row: 3 cards -->
    <div class="grid grid-standard">
      {standard.map(s => (
        <div class="card">
          <div class="card-meta">
            <span class="card-num">Case {s.id}</span>
            <span class="category">{s.category}</span>
          </div>
          <h3>{s.headline}</h3>
          <div class="context-label">{s.context}</div>
          <div class="sections">
            <div class="block">
              <div class="block-label">The problem</div>
              <p>{s.problem}</p>
            </div>
            <div class="block">
              <div class="block-label">The work</div>
              <p>{s.solution}</p>
            </div>
            <div class="outcome">
              <div class="outcome-icon" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="0" y="0" width="9" height="9" fill="#CFAE70"/>
                  <rect x="11" y="0" width="9" height="9" fill="none" stroke="#CFAE70" stroke-width="1"/>
                  <rect x="0" y="11" width="9" height="9" fill="none" stroke="#CFAE70" stroke-width="1"/>
                  <rect x="11" y="11" width="9" height="9" fill="#CFAE70"/>
                </svg>
              </div>
              <p>{s.outcome}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .grid {
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }

  .grid-featured {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: none;
  }

  .grid-standard {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
  }

  .card {
    background: var(--bg);
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: background 0.2s;
  }

  .card:hover { background: var(--surface); }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .card-num {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    color: var(--text-dim);
  }

  .category {
    font-size: 0.68rem;
    color: var(--gold);
    border: 1px solid rgba(207, 174, 112, 0.3);
    padding: 3px 9px;
    letter-spacing: 0.04em;
    font-weight: 400;
  }

  .card h3 {
    font-size: 1.1rem;
    color: var(--text);
    line-height: 1.45;
    font-weight: 500;
  }

  .grid-featured .card h3 {
    font-size: 1.2rem;
  }

  .context-label {
    font-size: 0.72rem;
    color: var(--text-dim);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 400;
  }

  .sections {
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex: 1;
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .block-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .block p {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.75;
    font-weight: 400;
    margin: 0;
  }

  .grid-featured .block p {
    color: #C4BAA8;
  }

  .outcome {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .outcome-icon { flex-shrink: 0; margin-top: 3px; }

  .outcome p {
    font-size: 0.875rem;
    color: var(--text);
    line-height: 1.7;
    font-weight: 400;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .grid-featured { grid-template-columns: 1fr 1fr; }
    .grid-standard { grid-template-columns: 1fr; }
  }

  @media (max-width: 768px) {
    .grid-featured { grid-template-columns: 1fr; border-bottom: none; }
    .grid-standard { grid-template-columns: 1fr; }
    .card { padding: 28px; }
  }
</style>
