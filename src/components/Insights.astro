---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
---

<section id="insights">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Insights</span>
      <h2>Latest thinking</h2>
    </div>
    <div class="grid">
      {posts.map(post => (
        <a href={`/blog/${post.slug}`} class="card">
          <div class="card-id">
            <svg width="14" height="14" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <rect x="0" y="0" width="9" height="9" fill="#CFAE70"/>
              <rect x="11" y="0" width="9" height="9" fill="none" stroke="#CFAE70" stroke-width="1"/>
              <rect x="0" y="11" width="9" height="9" fill="none" stroke="#CFAE70" stroke-width="1"/>
              <rect x="11" y="11" width="9" height="9" fill="#CFAE70"/>
            </svg>
            <span class="tag-label">
              {post.data.tags?.[0] ?? 'Insights'}
            </span>
          </div>
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
        </a>
      ))}
    </div>
    <div class="view-all">
      <a href="/blog">View all articles →</a>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }

  .card {
    background: var(--bg);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-decoration: none;
    transition: background 0.2s;
  }

  .card:hover { background: var(--surface); }

  .card-id {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: var(--gold);
  }

  .tag-label { color: var(--text-dim); }

  .card h3 {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 400;
    color: var(--text);
    line-height: 1.4;
  }

  .card p {
    color: var(--text-muted);
    font-size: 0.82rem;
    line-height: 1.7;
    font-weight: 300;
    flex: 1;
  }

  .view-all {
    margin-top: 24px;
    text-align: right;
  }

  .view-all a {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--gold);
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: opacity 0.2s;
  }

  .view-all a:hover { opacity: 0.7; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
