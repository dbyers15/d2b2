---
// Hero.astro
---

<section class="hero">
  <div class="container">
    <div class="hero-tag">
      <span class="eyebrow">Solutions Engineering &amp; Revenue Operations</span>
    </div>

    <h1 class="hero-headline">
      <span class="gold-gradient">Revenue</span><br />
      engineered<br />
      from the data up.
    </h1>

    <p class="hero-sub">
      Most inefficiencies are hiding in the data. d2b2 finds them, builds the
      integrations and automation to fix them, and hands over clean reporting
      so your team stays proactive long after the engagement ends. Paid
      marketing is one branch of the work.
    </p>

    <div class="hero-ctas">
      <a href="#contact" class="btn-primary">Start a Conversation</a>
      <a href="#services" class="btn-outline">See What I Do</a>
    </div>

    <div class="hero-credential">
      <span>Vanderbilt University, M.S. Data Science</span>
    </div>

    <div class="hero-stats">
      <div class="stat">
        <div class="stat-value">$2M+</div>
        <div class="stat-label">Revenue Under Management</div>
      </div>
      <div class="stat">
        <div class="stat-value">10+</div>
        <div class="stat-label">End-to-End Integrations Built</div>
      </div>
      <div class="stat">
        <div class="stat-value">4+</div>
        <div class="stat-label">Years in Business Systems</div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 64px 96px;
    border-top: none;
  }

  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 36px;
  }

  .hero-tag::before {
    content: '';
    display: block;
    width: 28px;
    height: 1px;
    background: var(--gold);
  }

  .hero-headline { margin-bottom: 28px; }

  .hero-sub {
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    color: var(--text-muted);
    max-width: 520px;
    margin-bottom: 44px;
    font-weight: 300;
    line-height: 1.75;
  }

  .hero-ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    align-items: center;
  }

  .hero-credential {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 18px;
  }

  .hero-credential::before {
    content: '';
    display: block;
    width: 16px;
    height: 1px;
    background: var(--gold);
    flex-shrink: 0;
  }

  .hero-credential span {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-dim);
    letter-spacing: 0.08em;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin-top: 72px;
    padding-top: 44px;
    border-top: 1px solid var(--border);
  }

  .stat-value {
    font-family: var(--font-mono);
    font-size: 2rem;
    font-weight: 500;
    color: var(--gold);
    line-height: 1;
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--text-dim);
    font-weight: 400;
    letter-spacing: 0.06em;
  }

  @media (max-width: 768px) {
    .hero { padding-block: 48px 60px; }
    .hero-stats { grid-template-columns: repeat(3, 1fr); gap: 0; margin-top: 48px; padding-top: 32px; }
  }
</style>
