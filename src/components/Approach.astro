---
// Approach.astro

const steps = [
  {
    num: '01',
    title: 'The Audit',
    body: 'Before building anything, understand what exists. What\'s working, what\'s wasting budget, and where the data is broken. Every engagement starts with a structured review of your stack, spend, and reporting so nothing gets rebuilt that didn\'t need to be.',
  },
  {
    num: '02',
    title: 'The Stack Build',
    body: 'Tracking, attribution, AI tools, and automation built right the first time. Infrastructure that doesn\'t break six months later, paid campaigns grounded in verified data, and systems documented as they\'re built.',
  },
  {
    num: '03',
    title: 'The Handoff',
    body: 'Everything built gets documented. You leave knowing how it works, how to manage it, and how to extend it. The goal isn\'t a retainer. It\'s a business that runs its own marketing stack after the engagement ends.',
  },
];
---

<section id="approach">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Approach</span>
      <h2>How every engagement works</h2>
    </div>

    <div class="steps">
      {steps.map(s => (
        <div class="step">
          <div class="step-num">{s.num}</div>
          <div class="step-content">
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .steps { display: flex; flex-direction: column; }

  .step {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 28px;
    padding-block: 36px;
    border-top: 1px solid var(--border);
    align-items: start;
  }

  .step:last-child { border-bottom: 1px solid var(--border); }

  .step-num {
    font-family: var(--font-display);
    font-size: 2.8rem;
    font-weight: 300;
    color: var(--border-strong);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .step-content h3 {
    color: var(--text);
    margin-bottom: 10px;
    font-size: 1.2rem;
  }

  .step-content p {
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.8;
    font-weight: 300;
  }

  @media (max-width: 768px) {
    .step { grid-template-columns: 48px 1fr; gap: 18px; }
  }
</style>
