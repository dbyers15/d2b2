---
// Nav.astro — sticky, blurred, collapses on mobile
---

<nav>
  <div class="nav-inner container">
    <a href="/" class="nav-logo">d2b2</a>
    <ul class="nav-links">
      <li><a href="#services">Services</a></li>
      <li><a href="#approach">Approach</a></li>
      <li><a href="#about">About</a></li>
      <li><a href="#contact" class="btn-primary">Work Together</a></li>
    </ul>
    <!-- Mobile CTA only -->
    <a href="#contact" class="nav-mobile-cta btn-primary">Talk</a>
  </div>
</nav>

<style>
  nav {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    background: rgba(28, 28, 28, 0.9);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
    z-index: 100;
    padding-block: 18px;
    padding-inline: var(--gutter);
    margin-inline: calc(-1 * var(--gutter));
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-logo {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 500;
    color: var(--gold);
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 400;
    transition: color 0.2s;
    letter-spacing: 0.01em;
  }

  .nav-links a:hover { color: var(--text); }

  .nav-mobile-cta { display: none; }

  @media (max-width: 768px) {
    .nav-links { display: none; }
    .nav-mobile-cta { display: inline-block; }
  }
</style>
