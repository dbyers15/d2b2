---
// Services.astro

const services = [
  {
    id: '01 / PAID',
    title: 'Paid Marketing Setup & Optimization',
    body: 'Full-funnel paid search and social infrastructure — account builds, campaign architecture, bidding strategy, and ongoing optimization grounded in attribution data.',
    tags: ['Google Ads', 'Meta Ads', 'Campaign Architecture', 'Attribution'],
  },
  {
    id: '02 / DATA',
    title: 'Revenue Analytics & Reporting',
    body: 'SQL-driven analysis, custom dashboards, and performance reporting that tell you what\'s actually driving revenue — and what isn\'t. From ad spend to pipeline to close.',
    tags: ['SQL', 'Dashboards', 'GA4', 'GTM'],
  },
  {
    id: '03 / OPS',
    title: 'Marketing Infrastructure',
    body: 'Tracking implementation, CRM workflows, automation pipelines, and the connective tissue between your tools — built to scale and documented so it doesn\'t break.',
    tags: ['HubSpot', 'Zapier', 'Tracking', 'Automation'],
  },
  {
    id: '04 / AEO',
    title: 'SEO & Answer Engine Optimization',
    body: 'Content strategy and optimization built for how people actually find answers — including AI-powered search. Organic growth that compounds without the ad spend.',
    tags: ['SEO', 'AEO / GEO', 'Content Strategy'],
  },
];
---

<section id="services">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Services</span>
      <h2>What d2b2 does</h2>
    </div>

    <div class="grid">
      {services.map(s => (
        <div class="card">
          <span class="card-id">{s.id}</span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
          <div class="tags">
            {s.tags.map(t => <span class="tag">{t}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }

  .card {
    background: var(--bg);
    padding: 36px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: background 0.2s;
  }

  .card:hover { background: var(--surface); }

  .card-id {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: var(--gold);
    border: 1px solid var(--border-strong);
    padding: 4px 10px;
    display: inline-block;
    width: fit-content;
  }

  .card h3 {
    font-size: 1.2rem;
    color: var(--text);
  }

  .card p {
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.75;
    font-weight: 300;
    flex: 1;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 4px;
  }

  .tag {
    font-size: 0.68rem;
    color: var(--text-dim);
    border: 1px solid var(--border);
    padding: 3px 9px;
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  @media (max-width: 768px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
