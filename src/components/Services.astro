---
// Services.astro

const top = {
  id: '01 / ENG',
  title: 'AI Solutions Engineering',
  body: 'End-to-end builds using AI tools, Python, and custom integrations — API connections, data pipelines, automation, and reporting systems that make your stack work as one. We don\'t spec it out for a dev team. We build it.',
  tags: ['AI Tools', 'API Integrations', 'Python', 'Data Pipelines', 'Automation'],
};

const mid = [
  {
    id: '02 / PAID',
    title: 'Paid Marketing Setup & Optimization',
    body: 'Full-funnel paid search and social built on real attribution data, not platform numbers. Account builds, campaign architecture, bidding strategy, and proactive optimization driven by what\'s actually converting.',
    tags: ['Google Ads', 'Meta Ads', 'Campaign Architecture', 'Attribution'],
  },
  {
    id: '03 / REVOPS',
    title: 'Revenue Operations',
    body: 'Pipeline strategy, lead scoring, and sales-marketing handoff automation that close the loop between marketing spend and closed revenue. The strategic layer that makes the data and the stack actually work together.',
    tags: ['Pipeline', 'Lead Scoring', 'CRM Workflows', 'Attribution'],
  },
];

const bottom = [
  {
    id: '04 / OPS',
    title: 'Marketing Infrastructure',
    body: 'Tracking implementation, CRM tool setup, and automation pipelines that wire your stack together and reduce manual overhead. Built to scale, documented so your team can run it.',
    tags: ['HubSpot', 'Tracking', 'GTM / GA4', 'Automation'],
  },
  {
    id: '05 / AEO',
    title: 'SEO & Answer Engine Optimization',
    body: 'Content strategy and optimization built for how people actually find answers, including AI search engines. Organic visibility that compounds long after the engagement ends.',
    tags: ['SEO', 'AEO / GEO', 'Content Strategy'],
  },
  {
    id: '06 / DATA',
    title: 'Revenue Analytics & Reporting',
    body: 'SQL-driven analysis and custom reporting that give executives a clear view of what drives revenue and what wastes budget. Clean data and honest answers, not seasonal guesses.',
    tags: ['SQL', 'Dashboards', 'GA4', 'GTM'],
  },
];

const icon = `<svg width="14" height="14" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <rect x="0" y="0" width="9" height="9" fill="#CFAE70"/>
  <rect x="11" y="0" width="9" height="9" fill="none" stroke="#CFAE70" stroke-width="1"/>
  <rect x="0" y="11" width="9" height="9" fill="none" stroke="#CFAE70" stroke-width="1"/>
  <rect x="11" y="11" width="9" height="9" fill="#CFAE70"/>
</svg>`;
---

<section id="services">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Services</span>
      <h2>What d2b2 does</h2>
    </div>

    <div class="pyramid">

      <div class="pyramid-row row-top">
        <div class="card">
          <div class="card-id">
            <Fragment set:html={icon} />
            <span>{top.id}</span>
          </div>
          <h3>{top.title}</h3>
          <p>{top.body}</p>
          <div class="tags">{top.tags.map(t => <span class="tag">{t}</span>)}</div>
        </div>
      </div>

      <div class="pyramid-row row-mid">
        {mid.map(s => (
          <div class="card">
            <div class="card-id">
              <Fragment set:html={icon} />
              <span>{s.id}</span>
            </div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
            <div class="tags">{s.tags.map(t => <span class="tag">{t}</span>)}</div>
          </div>
        ))}
      </div>

      <div class="pyramid-row row-bottom">
        {bottom.map(s => (
          <div class="card">
            <div class="card-id">
              <Fragment set:html={icon} />
              <span>{s.id}</span>
            </div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
            <div class="tags">{s.tags.map(t => <span class="tag">{t}</span>)}</div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  .pyramid {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }

  .pyramid-row {
    display: flex;
    gap: 1px;
  }

  .card {
    background: var(--bg);
    padding: 36px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1;
    transition: background 0.2s;
  }

  .card:hover { background: var(--surface); }

  .card-id {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: var(--gold);
  }

  .card h3 {
    font-size: 1.2rem;
    color: var(--text);
  }

  .card p {
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.75;
    font-weight: 300;
    flex: 1;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 4px;
  }

  .tag {
    font-size: 0.68rem;
    color: var(--text-dim);
    border: 1px solid var(--border);
    padding: 3px 9px;
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  /* Mobile: single column stack */
  @media (max-width: 768px) {
    .pyramid-row { flex-direction: column; }
    .card { padding: 24px; }
  }

  /* Tablet: keep top solo, mid 2-col, bottom 2-col (wrap last card) */
  @media (min-width: 769px) and (max-width: 1024px) {
    .row-bottom {
      flex-wrap: wrap;
    }
    .row-bottom .card {
      flex: 1 1 calc(50% - 1px);
    }
    .row-bottom .card:last-child {
      flex: 1 1 100%;
    }
  }
</style>
