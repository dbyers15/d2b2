---
// Services.astro

const services = [
  {
    id: '01 / PAID',
    title: 'Paid Marketing Setup & Optimization',
    body: 'Full-funnel paid search and social built on real attribution data, not platform numbers. Account builds, campaign architecture, bidding strategy, and proactive optimization driven by what\'s actually converting.',
    tags: ['Google Ads', 'Meta Ads', 'Campaign Architecture', 'Attribution'],
  },
  {
    id: '02 / DATA',
    title: 'Revenue Analytics & Reporting',
    body: 'SQL-driven analysis and custom reporting that give executives a clear view of what drives revenue and what wastes budget. Clean data and honest answers, not seasonal guesses.',
    tags: ['SQL', 'Dashboards', 'GA4', 'GTM'],
  },
  {
    id: '03 / OPS',
    title: 'Marketing Infrastructure',
    body: 'Tracking implementation, CRM workflows, AI tool setup, and automation pipelines that connect your stack and reduce manual overhead. Built to scale, documented so your team can run it without coming back.',
    tags: ['HubSpot', 'AI Tools', 'Tracking', 'Automation'],
  },
  {
    id: '04 / AEO',
    title: 'SEO & Answer Engine Optimization',
    body: 'Content strategy and optimization built for how people actually find answers, including AI search engines. Organic visibility that compounds long after the engagement ends.',
    tags: ['SEO', 'AEO / GEO', 'Content Strategy'],
  },
];
---

<section id="services">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Services</span>
      <h2>What d2b2 does</h2>
    </div>

    <div class="grid">
      {services.map(s => (
        <div class="card">
          <div class="card-id">
            <svg width="14" height="14" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <rect x="0" y="0" width="9" height="9" fill="#CFAE70"/>
              <rect x="11" y="0" width="9" height="9" fill="none" stroke="#CFAE70" stroke-width="1"/>
              <rect x="0" y="11" width="9" height="9" fill="none" stroke="#CFAE70" stroke-width="1"/>
              <rect x="11" y="11" width="9" height="9" fill="#CFAE70"/>
            </svg>
            <span>{s.id}</span>
          </div>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
          <div class="tags">
            {s.tags.map(t => <span class="tag">{t}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }

  .card {
    background: var(--bg);
    padding: 36px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: background 0.2s;
  }

  .card:hover { background: var(--surface); }

  .card-id {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: var(--gold);
  }

  .card h3 {
    font-size: 1.2rem;
    color: var(--text);
  }

  .card p {
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.75;
    font-weight: 300;
    flex: 1;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 4px;
  }

  .tag {
    font-size: 0.68rem;
    color: var(--text-dim);
    border: 1px solid var(--border);
    padding: 3px 9px;
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  @media (max-width: 768px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
