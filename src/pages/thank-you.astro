---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Message Received | d2b2"
  description="Thanks for reaching out to d2b2. We'll be in touch within 24 hours."
>
  <Nav />
  <main>
    <div class="container wrap">
      <div class="mark" aria-hidden="true">
        <svg width="48" height="48" viewBox="0 0 20 20" fill="none">
          <rect x="0" y="0" width="9" height="9" fill="#CFAE70"/>
          <rect x="11" y="0" width="9" height="9" fill="none" stroke="#CFAE70" stroke-width="1"/>
          <rect x="0" y="11" width="9" height="9" fill="none" stroke="#CFAE70" stroke-width="1"/>
          <rect x="11" y="11" width="9" height="9" fill="#CFAE70"/>
        </svg>
      </div>
      <h1>Message received.</h1>
      <p class="sub">You'll hear back within 24 hours. In the meantime, take a look at the Insights section for frameworks and thinking on paid marketing, RevOps, and marketing analytics.</p>
      <div class="actions">
        <a href="/" class="btn-primary">Back to home</a>
        <a href="/blog" class="btn-ghost">Read Insights</a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .wrap {
    max-width: 560px;
    margin-inline: auto;
    padding-block: 120px 96px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .mark {
    margin-bottom: 8px;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 300;
    color: var(--text);
    line-height: 1.1;
  }

  .sub {
    font-size: 0.95rem;
    color: var(--text-muted);
    font-weight: 300;
    line-height: 1.75;
    max-width: 480px;
  }

  .actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: 12px 26px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold);
    border: 1px solid var(--border-strong);
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }

  .btn-ghost:hover {
    border-color: var(--gold);
    color: var(--text);
  }

  @media (max-width: 768px) {
    .wrap { padding-block: 80px 72px; }
  }
</style>
